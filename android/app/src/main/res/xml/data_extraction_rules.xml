<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada do app vai para backup em nuvem nem para transferência entre aparelhos.
     O dado clínico mora no Supabase (isolado por RLS); localmente só há sessão de login,
     preferências e telemetria pendente — nada que deva sair do aparelho. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
