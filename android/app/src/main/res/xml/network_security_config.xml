<?xml version="1.0" encoding="utf-8"?>
<!-- Release: só HTTPS, e só CAs do sistema (CAs instaladas pelo usuário não interceptam o
     tráfego). Builds debug sobrescrevem este arquivo em src/debug/res/xml/. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
