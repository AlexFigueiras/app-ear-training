<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Mínimo privilégio (política de permissões da Play + LGPD art. 6º, III): o app não grava
         áudio nem usa APIs de Bluetooth — a detecção de fones usa AudioManager.getDevices(), que
         não exige permissão. RECORD_AUDIO/BLUETOOTH_* foram removidas. Ver docs/DECISIONS.md.
         Entram pelas bibliotecas (manifest merge): com.android.vending.BILLING (assinatura PRO)
         e ACCESS_NETWORK_STATE + com.google.android.gms.permission.AD_ID (anúncios do AdMob;
         declarar "ID de publicidade" na Play Console, docs/PLAY_STORE.md). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-feature android:name="android.hardware.audio.low_latency" android:required="false" />
    <uses-feature android:name="android.hardware.audio.pro" android:required="false" />

    <!-- allowBackup=false + dataExtractionRules: sessão do Supabase e telemetria clínica pendente
         não vão para backup em nuvem nem para transferência entre aparelhos. -->
    <application
        android:label="BOSYN"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- AdMob (lib/services/ads_service.dart): o ID do app vem do .env pelo Gradle
             (manifestPlaceholders em android/app/build.gradle.kts); sem ele, o ID de teste. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <!-- A medição do SDK de anúncios só começa quando o app liga os anúncios (plano grátis):
             para quem assina o PRO, o AdMob não coleta nada. -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
