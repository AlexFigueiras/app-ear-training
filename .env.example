# Copie para .env e preencha com valores reais. .env é gitignored (ver AGENTS.md seção 7).
# O app carrega estas chaves via flutter_dotenv (declarado como asset em pubspec.yaml).

# URL do projeto Supabase (BaaS externo — schema gerido fora deste repo)
SUPABASE_URL=

# Chave anônima do Supabase — pública, restrita por RLS. NUNCA a service_role key aqui
# (este é código 100% cliente, ver AGENTS.md seção 7, lei 2).
SUPABASE_ANON_KEY=

# Chave da API Google Text-to-Speech, usada por lib/services/tts_service.dart
GOOGLE_TTS_API_KEY=
